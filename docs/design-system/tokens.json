{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Interprete. Design System",
    "version": "1.0.0",
    "date": "2026-09-04",
    "note": "D001 define a dominância visual aproximada: 58 Pink Essence, 28 Dark Amaranth, 7 Classic Crimson, 5 Debian Red e até 2 Crimson Violet."
  },
  "color": {
    "brand": {
      "pinkEssence": { "$type": "color", "$value": "#F1EBE8" },
      "darkAmaranth": { "$type": "color", "$value": "#8C1535" },
      "crimsonViolet": { "$type": "color", "$value": "#410230" },
      "classicCrimson": { "$type": "color", "$value": "#D62839" },
      "debianRed": { "$type": "color", "$value": "#D60858" }
    },
    "support": {
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#000000" },
      "ink": { "$type": "color", "$value": "#40222F" },
      "muted": { "$type": "color", "$value": "#7A5A69" },
      "border": { "$type": "color", "$value": "#E2D6D1" },
      "canvas": { "$type": "color", "$value": "#E4DAD5" }
    }
  },
  "composition": {
    "pinkEssence": { "$type": "number", "$value": 58 },
    "darkAmaranth": { "$type": "number", "$value": 28 },
    "classicCrimson": { "$type": "number", "$value": 7 },
    "debianRed": { "$type": "number", "$value": 5 },
    "crimsonVioletMax": { "$type": "number", "$value": 2 }
  },
  "fontFamily": {
    "display": { "$type": "fontFamily", "$value": ["Source Serif Pro", "Georgia", "Times New Roman", "serif"] },
    "body": { "$type": "fontFamily", "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["IBM Plex Mono", "Menlo", "Consolas", "monospace"] }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "5": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "10": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } },
    "16": { "$type": "dimension", "$value": { "value": 64, "unit": "px" } },
    "18": { "$type": "dimension", "$value": { "value": 72, "unit": "px" } },
    "24": { "$type": "dimension", "$value": { "value": 96, "unit": "px" } }
  },
  "border": {
    "subtle": { "$type": "dimension", "$value": { "value": 1, "unit": "px" } },
    "strong": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } }
  },
  "radius": {
    "default": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } },
    "micro": { "$type": "dimension", "$value": { "value": 2, "unit": "px" } },
    "brand": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "pill": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 160, "unit": "ms" } },
    "default": { "$type": "duration", "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$type": "duration", "$value": { "value": 220, "unit": "ms" } }
  },
  "layout": {
    "containerMaxPx": { "$type": "number", "$value": 1440 },
    "readingMaxCh": { "$type": "number", "$value": 68 },
    "touchTargetMinPx": { "$type": "number", "$value": 44 }
  }
}
